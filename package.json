{
  "name": "nfc",
  "version": "1.0.0",
  "description": "NFC Agent App",
  "author": "Fajar",
  "main": "main.js",
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w nfc-pcsc",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder --publish=never",
    "dist:win": "electron-builder --win nsis --publish=never",
    "dist:mac": "electron-builder --mac dmg --publish=never"
  },
  "build": {
    "appId": "com.nfc.agent",
    "productName": "NFC Agent",
    "files": [
      "main.js",
      "index.js",
      "socket-server.js",
      "socket-client-example.html",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "artifactName": "${productName}-${version}.dmg"
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.exe"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/nfc-pcsc/**/*",
      "node_modules/@pokusew/pcsclite/**/*"
    ]
  },
  "dependencies": {
    "ndef": "^0.2.0",
    "nfc-pcsc": "^0.8.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9"
  }
}
